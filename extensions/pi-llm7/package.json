{
  "name": "@pi-desktop/pi-llm7",
  "version": "0.1.0",
  "description": "Optional-key LLM7 provider for pi (provider id llm7-free, free default/fast selectors).",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": ["pi-package", "pi-extension", "llm7"],
  "files": ["dist", "README.md"],
  "publishConfig": { "access": "public" },
  "pi": {
    "extensions": ["dist/index.js"]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf dist"
  }
}
